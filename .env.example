# Copy to .env and fill in. .env is gitignored — never commit it.

# From Entra ID > App registrations > nightshift-diagnostic > Overview
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=

# From Certificates & secrets > New client secret > Value column
FABRIC_CLIENT_SECRET=

# The workspace holding MFI, used for calibration
CALIBRATION_WORKSPACE=PowerBiProjects

# Model API for the agent layer. Not needed until week 5.
MODEL_API_KEY=
MODEL_NAME=
